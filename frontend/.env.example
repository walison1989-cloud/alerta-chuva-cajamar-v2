# =====================================================================
# Alerta de Chuva Cajamar - variáveis do frontend (Vite)
# Copie este arquivo para `.env.local` e ajuste os valores.
#
# IMPORTANTE:
# - Tudo que começa com VITE_ é incorporado ao bundle público.
# - NUNCA coloque a service_role key do Supabase aqui.
# - A chave pública do Supabase (anon/publishable) só deve ser usada
#   com Row Level Security habilitado nas tabelas.
# =====================================================================

# Identidade do aplicativo
VITE_APP_NAME=Alerta de Chuva Cajamar

# Município de referência (centro administrativo aproximado, OSM)
VITE_MUNICIPIO_NOME=Cajamar
VITE_MUNICIPIO_UF=SP
VITE_MUNICIPIO_LAT=-23.3561111
VITE_MUNICIPIO_LON=-46.8769444
VITE_TIMEZONE=America/Sao_Paulo


# Fonte meteorológica (Etapa 1)
# A Open-Meteo é pública e não exige chave para uso não comercial.
# Leia os termos em https://open-meteo.com/en/terms
VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Supabase (Etapa 2)
# Copie a URL do projeto e a chave anon/publishable em Project Settings > API.
# Sem estes valores, login e endereço ficam indisponíveis, mas a tela inicial
# continua funcionando. NUNCA use a service_role aqui.
# Configure também as Redirect URLs do Auth:
#   http://localhost:5173/entrar
#   http://localhost:5173/redefinir-senha
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Consulta de CEP (ViaCEP, público e sem chave)
VITE_VIACEP_BASE_URL=https://viacep.com.br/ws/

# Geocodificação (Etapa 2)
# A consulta é feita pela Edge Function `geocode-address` do Supabase, que
# guarda a chave OPENGEOCODING_API_KEY como secret no servidor. Nenhuma chave
# de geocodificação é exposta ao navegador.
#
# Deploy da função e configuração dos secrets: veja `supabase/README.md`.
# O nome abaixo precisa corresponder ao nome da função publicada.
VITE_GEOCODING_FUNCTION=geocode-address

# Habilita a análise preventiva experimental (Etapa 5.2).
# É um kill switch: com false, a página /analise-preventiva não consulta as
# RPCs nem executa o motor. O módulo NÃO é alerta oficial e NÃO estima
# probabilidade de alagamento. Requer as migrations da Etapa 5.2 aplicadas.
VITE_ENABLE_EXPERIMENTAL_ANALYSIS=true

# Etapa 3 - leitura direta do CEMADEN
# Modo secundario, sem persistencia e sem PostGIS. Use quando a sincronizacao
# via Edge Function ainda nao estiver publicada. A interface identifica essa
# origem e nao calcula distancias do imovel nesse modo.
VITE_ENABLE_CEMADEN_LIVE_FALLBACK=false
