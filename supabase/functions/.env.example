# =====================================================================
# Edge Function: geocode-address
# =====================================================================
# Referência para execução local com `supabase functions serve`.
# NÃO coloque segredos reais neste arquivo nem em arquivos versionados.
# Em produção, configure com:
#   npx supabase secrets set OPENGEOCODING_API_KEY=...
# =====================================================================

# Obrigatórios (injetados automaticamente quando servidos pelo Supabase)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA-CHAVE-ANON-PUBLICA

# Chave privada da OpenGeocoding. Nunca vai para o frontend.
OPENGEOCODING_API_KEY=

# Origens autorizadas, separadas por vírgula. Use `*` apenas em desenvolvimento.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Opcionais: restringem a validação do resultado.
MUNICIPIO_NOME=Cajamar
MUNICIPIO_UF=SP

# =====================================================================
# Edge Function: sync-cemaden
# =====================================================================
# Segredo exigido no header x-sync-secret. Gere um valor longo e aleatório.
CEMADEN_SYNC_SECRET=

# Endpoint JSONP público do CEMADEN (chuva acumulada em 24 h).
CEMADEN_ENDPOINT=https://resources.cemaden.gov.br/dados/311_24.json

# Raio de seleção ao redor do centro de Cajamar, em km (1 a 100).
CEMADEN_RADIUS_KM=30

# =====================================================================
# Web Push v1.5: servidor (Edge Function push-alertas)
# =====================================================================
# NÃO subir os valores reais em GitHub. Configure como Secrets no Supabase.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email-de-contato@example.com
PUSH_JOB_SECRET=
PUSH_ALERTS_ENABLED=false
# Permanece false até o motor HIDROLÓGICO NO SERVIDOR produzir eventos auditados.
PUSH_FLOOD_ALERTS_ENABLED=false
# SUPABASE_SERVICE_ROLE_KEY é injetada nos segredos do projeto / runtime
